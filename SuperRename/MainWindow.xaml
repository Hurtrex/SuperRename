<Window x:Class="SuperRename.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SuperRename" Width="1280" Height="720" MinWidth="900" MinHeight="460"
        WindowStartupLocation="CenterScreen" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="OnePanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BrowserColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="BrowserPanel" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="8,10,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="UpButton" Click="Up_Click" MinWidth="0" Padding="10,6" Margin="0,0,8,0"
                            ToolTip="Select the parent folder">
                        <TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </Button>
                    <TextBlock x:Name="BreadcrumbText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Cursor="Hand" MouseLeftButtonUp="Breadcrumb_Click"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="12" Margin="10,4,10,10"
                           TextWrapping="Wrap" Text="Click to select. Double-click a folder to open it."/>
                <ListView x:Name="BrowserList" SelectionMode="Single" BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="BrowserList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="MinHeight" Value="28"/>
                            <Setter Property="Padding" Value="8,2"/>
                            <EventSetter Event="MouseDoubleClick" Handler="BrowserRow_DoubleClick"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding Indent}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding Display}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsParent}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMarkedForDelete}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Hint}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
            <GridSplitter x:Name="BrowserSplitter" Grid.Column="1" Width="4" Visibility="Collapsed"
                          HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

            <Grid Grid.Column="2" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="12"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBox x:Name="PreviewText" Visibility="Collapsed" IsReadOnly="True" IsTabStop="False"
                         FontFamily="Consolas" FontSize="12" Background="Transparent"
                         BorderThickness="0" Margin="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <ListView x:Name="PreviewList" Visibility="Collapsed" Margin="12" IsTabStop="False"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="MinHeight" Value="28"/>
                            <Setter Property="Padding" Value="8,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Hint}"
                                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="PreviewHint" Visibility="Collapsed" Style="{StaticResource Hint}" Margin="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Click a file on the left to preview it.&#x0a;Double-click a folder to open it."/>
                <TextBlock x:Name="PreviewInfo" Grid.Row="1" Style="{StaticResource Hint}" Margin="12,0,12,10"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <DockPanel Grid.Column="3" Margin="20" LastChildFill="False">
                <TextBlock x:Name="CounterText" DockPanel.Dock="Top" FontSize="22" FontWeight="SemiBold"/>

                <TextBlock DockPanel.Dock="Top" Text="Original name" Style="{StaticResource Hint}" Margin="0,16,0,2"/>
                <TextBlock x:Name="OriginalText" DockPanel.Dock="Top" TextWrapping="Wrap"/>
                <TextBlock x:Name="FolderText" DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>

                <TextBlock DockPanel.Dock="Top" Text="New name" Style="{StaticResource Hint}" Margin="0,20,0,2"/>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" KeyDown="Box_KeyDown"/>
                    <TextBlock Grid.Column="1" Text="." FontSize="18" Margin="4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="ExtBox" Grid.Column="2" TextChanged="ExtBox_TextChanged" KeyDown="Box_KeyDown"
                             ToolTip="Extension. Leave empty for no extension."/>
                </Grid>
                <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="BackButton" Content="Back" Click="Back_Click"/>
                    <Button x:Name="NextButton" Content="Next" Click="Next_Click" ToolTip="Next (Enter)"/>
                    <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click"
                            ToolTip="Mark for deletion. Nothing is deleted until you press Finish."/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                    <Button Content="Review all" Click="Review_Click"/>
                    <Button Content="Cancel" Click="Cancel_Click"/>
                </StackPanel>
                <TextBlock x:Name="SummaryText" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
            </DockPanel>
        </Grid>

        <DockPanel x:Name="ReviewPanel" Visibility="Collapsed" Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Review" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap"
                       Text="Edit names directly in the table. Double-click an original name to open it with its preview. Nothing is renamed or deleted until you click Finish."/>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button Content="Back to one by one" Click="BackToOne_Click"/>
                <Button x:Name="FinishButton" DockPanel.Dock="Right" Content="Finish" FontWeight="SemiBold" Margin="0"
                        Click="Finish_Click"/>
                <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click"/>
                <TextBlock x:Name="ReviewSummary" VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="8,0"/>
            </DockPanel>

            <DataGrid x:Name="ReviewGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" RowHeight="34">
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="OriginalCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="ToolTip" Value="Double-click to open with preview"/>
                        <EventSetter Event="MouseDoubleClick" Handler="Original_DoubleClick"/>
                    </Style>
                    <Style x:Key="NameCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMarkedForDelete}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="ExtCell" TargetType="DataGridCell" BasedOn="{StaticResource NameCell}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDir}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="CellText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMarkedForDelete}" Value="True">
                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="StatusText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMarkedForDelete}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Original" Binding="{Binding DisplayName}" IsReadOnly="True" Width="2*"
                                        CellStyle="{StaticResource OriginalCell}" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="New name" Binding="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                        CellStyle="{StaticResource NameCell}" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Ext" Binding="{Binding NewExt, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                        CellStyle="{StaticResource ExtCell}" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="2*"
                                        ElementStyle="{StaticResource StatusText}"/>
                    <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" IsReadOnly="True" Width="*"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding DeleteLabel}" Click="RowDelete_Click"
                                            Padding="8,0" Margin="2" MinWidth="96"/>
                                    <Button Content="Revert" Click="Revert_Click" IsEnabled="{Binding IsChanged}"
                                            Padding="8,0" Margin="2" MinWidth="0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <ComboBox x:Name="ThemeBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0" Width="110"
                  ToolTip="Theme" SelectionChanged="ThemeBox_SelectionChanged">
            <ComboBoxItem Content="System"/>
            <ComboBoxItem Content="Light"/>
            <ComboBoxItem Content="Dark"/>
        </ComboBox>
    </Grid>
</Window>
